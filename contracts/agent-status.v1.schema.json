{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:agent-status:v1",
  "title": "openwiz.agent-status.v1",
  "description": "The fields of a ticket's status comment, as read from its seven field lines after the marker line '<!-- openwiz.agent-status.v1 -->'. See agent-status.v1.md for the comment's text form, which comment counts, the state labels and what it never holds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "harness", "model", "step", "time", "pr", "preview"],
  "properties": {
    "schema": {
      "const": "openwiz.agent-status.v1"
    },
    "kind": {
      "enum": ["builder", "reviewer", "fleet"]
    },
    "harness": {
      "$ref": "#/$defs/short"
    },
    "model": {
      "$ref": "#/$defs/short"
    },
    "step": {
      "$ref": "#/$defs/text"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pr": {
      "type": "string",
      "pattern": "^(none|https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*)$"
    },
    "preview": {
      "type": "string",
      "pattern": "^(none|https://[^\\s\"<>]+)$",
      "maxLength": 300
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\u0000-\\u001f\\u007f\"\\u201c\\u201d>][^\\u0000-\\u001f\\u007f\"\\u201c\\u201d]*$"
    },
    "short": {
      "$ref": "#/$defs/text",
      "maxLength": 60
    },
    "label": {
      "description": "The four state labels; a ticket carries at most one.",
      "enum": ["building", "in-review", "needs-you", "held"]
    }
  }
}
