#!/usr/bin/env python3
"""A synthetic `gh` for write-driver's tests. It appends each call (argv and stdin) as one JSON line to the
file FAKE_GH_LOG names and answers from the JSON file FAKE_GH_WORLD names: `login`, `issues` (each
`number`, `title`, `state`, `pinned`) and `comment_exit`. It never reaches GitHub."""
import json, os, sys
args = sys.argv[1:]
stdin = '' if sys.stdin.isatty() else sys.stdin.read()
with open(os.environ['FAKE_GH_LOG'], 'a') as f:
    f.write(json.dumps({'argv': args, 'stdin': stdin}) + '\n')
with open(os.environ['FAKE_GH_WORLD']) as f:
    world = json.load(f)
if args[:2] == ['api', 'user']:
    print(world['login'])
elif args[:2] == ['api', 'graphql']:
    issues = world['issues']
    one = [i for i in issues if i['number'] == 1966]
    print(json.dumps({'data': {'repository': {
        'issue': ({k: one[0][k] for k in ('number', 'title', 'state')} if one else None),
        'pinnedIssues': {'nodes': [{'issue': {k: i[k] for k in ('number', 'title', 'state')}}
                                   for i in issues if i['pinned']]}}}}))
elif args[:2] == ['issue', 'comment']:
    sys.exit(world.get('comment_exit', 0))
else:
    sys.exit(9)
