{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "dg-workflow-red-loop-first",
 "skills": [
  "diagnose"
 ],
 "category": "workflow",
 "brief": "Use the diagnose skill (read 'skills/diagnose/SKILL.md'): on ticket #7301, `cargo test -p sorter --test order` fails intermittently. Report what you find on the ticket.",
 "world": {
  "github": {
   "issues": {
    "7301": {
     "title": "Sort is unstable",
     "labels": [
      "ready-for-agent"
     ]
    }
   },
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "cargo",
     "test"
    ],
    "out": "test order::ties ... FAILED\nassertion failed: left == right\n",
    "code": 101
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "cargo test"
   },
   {
    "write": "gh issue comment",
    "args": [
     "7301"
    ]
   }
  ],
  "allow": [
   {
    "write": "gh issue edit",
    "args": [
     "7301",
     "needs-info"
    ]
   }
  ],
  "forbid": [
   {
    "write": "git push"
   },
   {
    "write": "gh pr merge"
   },
   {
    "write": "room-cli thread spawn"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "runs the red loop first, then reports",
    "events": [
     [
      "read",
      "cargo test -p sorter --test order"
     ],
     [
      "write",
      "gh issue comment 7301",
      "Loop: cargo test ... red: ties."
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "reports before running anything",
    "reason": "missing-action",
    "events": [
     [
      "write",
      "gh issue comment 7301",
      "Probably a race."
     ]
    ]
   }
  ]
 }
}
