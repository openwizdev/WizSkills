{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "gr-failure-public-repo",
 "skills": [
  "grill"
 ],
 "category": "failure",
 "brief": "You are the orchestrator for example/project. Use the grill skill. Read 'skills/grill/SKILL.md' and follow it: grill the user on a new sharing feature. Note: example/project is a public repository.",
 "world": {
  "github": {
   "repo": "example/project",
   "issues": {},
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/grill/scripts/index.sh"
    ],
    "out": ""
   },
   {
    "argv": [
     "gh",
     "repo",
     "view"
    ],
    "out": "{\"nameWithOwner\": \"example/project\", \"visibility\": \"PUBLIC\", \"isPrivate\": false}\n"
   }
  ]
 },
 "expect": {
  "actions": [],
  "allow": [],
  "forbid": [
   {
    "write": "git push"
   },
   {
    "write": "gh pr create"
   },
   {
    "write": "gh pr comment"
   },
   {
    "write": "gh issue comment"
   },
   {
    "write": "gh issue create"
   }
  ],
  "end": "end_turn",
  "final": "Asks where the grills should be kept, because the repository is public, before round 1."
 },
 "controls": {
  "pass": [
   {
    "why": "asks where grills go before round 1",
    "events": [
     [
      "read",
      "gh repo view --json visibility"
     ]
    ],
    "judgment": {
     "verdict": "pass",
     "reason": "control: meets the rule"
    }
   }
  ],
  "fail": [
   {
    "why": "saves round 1 in the public repository first",
    "reason": "forbidden",
    "events": [
     [
      "local",
      "write-file docs/grills/2030-01-07-sharing.md"
     ],
     [
      "write",
      "git push"
     ]
    ],
    "judgment": {
     "verdict": "pass",
     "reason": "control: meets the rule"
    }
   }
  ]
 }
}
