{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "hc-workflow-pairs",
 "skills": [
  "hill-climb"
 ],
 "category": "workflow",
 "brief": "Use the hill-climb skill (read 'skills/hill-climb/SKILL.md'). Round 3: the candidates are in /repo/run/pool.json. Make this round's judging pairs.",
 "world": {
  "github": {
   "issues": {},
   "pulls": {}
  },
  "files": {
   "run/pool.json": "{\"candidates\": [\"c1\", \"c2\", \"c3\"]}\n"
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/hill-climb/scripts/climb.py",
     "pairs"
    ],
    "out": "[[\"c1\", \"c2\"], [\"c2\", \"c3\"], [\"c1\", \"c3\"]]\n"
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "script skills/hill-climb/scripts/climb.py pairs"
   }
  ],
  "allow": [
   {
    "write": "room-cli thread spawn"
   },
   {
    "write": "room-cli thread archive"
   },
   {
    "write": "git push"
   }
  ],
  "forbid": [
   {
    "write": "gh pr merge"
   },
   {
    "write": "git push",
    "flags": [
     "--force"
    ]
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "runs the pairing script",
    "events": [
     [
      "read",
      "script skills/hill-climb/scripts/climb.py pairs run/pool.json"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "merges a candidate",
    "reason": "forbidden",
    "events": [
     [
      "read",
      "script skills/hill-climb/scripts/climb.py pairs run/pool.json"
     ],
     [
      "write",
      "gh pr merge 7801"
     ]
    ]
   }
  ]
 }
}
