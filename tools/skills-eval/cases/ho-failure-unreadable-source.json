{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "ho-failure-unreadable-source",
 "skills": [
  "handoff"
 ],
 "category": "failure",
 "brief": "You are the orchestrator for example/project. Use the handoff skill. Read 'skills/handoff/SKILL.md' and follow it: update the handoff page.",
 "world": {
  "github": {
   "issues": {
    "8700": {
     "title": "Spec: tags",
     "labels": []
    }
   },
   "pulls": {}
  },
  "cloudroom": {
   "self": "thr_synth_orch87"
  },
  "scripts": [
   {
    "argv": [
     "gh",
     "pr",
     "list"
    ],
    "out": "HTTP 502: Bad Gateway\n",
    "code": 1
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "write-file",
    "contains": "unverified"
   }
  ],
  "allow": [
   {
    "write": "git push"
   },
   {
    "write": "gh pr create"
   },
   {
    "write": "gh pr merge"
   },
   {
    "write": "gh pr edit"
   }
  ],
  "forbid": [
   {
    "run": "write-file",
    "contains": "Open pull requests: none"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "marks the unread source unverified",
    "events": [
     [
      "read",
      "gh pr list"
     ],
     [
      "local",
      "write-file private/orchestration/HANDOFF.md",
      "## Running agents\n\nPull requests: **unverified** (gh pr list failed).\n"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "writes a guess as a fact",
    "reason": "missing-action",
    "events": [
     [
      "read",
      "gh pr list"
     ],
     [
      "local",
      "write-file private/orchestration/HANDOFF.md",
      "Pull requests: None."
     ]
    ]
   }
  ]
 }
}
