{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "ho-workflow-after-approval",
 "skills": [
  "handoff"
 ],
 "category": "workflow",
 "brief": "You are the orchestrator for example/project. Use the handoff skill. Read 'skills/handoff/SKILL.md' and follow it: the user just approved the plan graph on spec #6500.",
 "world": {
  "github": {
   "issues": {
    "6500": {
     "title": "Spec: search",
     "labels": []
    },
    "6501": {
     "title": "Index the titles",
     "labels": [
      "ready-for-agent"
     ],
     "parent": 6500
    }
   },
   "pulls": {}
  },
  "cloudroom": {
   "self": "thr_synth_orch",
   "loops": [
    {
     "id": "loop_synth_1",
     "cron": "*/30 * * * *"
    }
   ]
  }
 },
 "expect": {
  "actions": [
   {
    "write": "git push"
   },
   {
    "write": "gh pr create"
   }
  ],
  "allow": [
   {
    "write": "gh pr merge"
   },
   {
    "write": "gh pr edit"
   }
  ],
  "forbid": [
   {
    "write": "gh issue edit"
   },
   {
    "write": "room-cli thread spawn"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "rewrites the page and lands it through a pull request",
    "events": [
     [
      "read",
      "gh issue list"
     ],
     [
      "local",
      "write-file private/orchestration/HANDOFF.md"
     ],
     [
      "write",
      "git push -u origin room/handoff"
     ],
     [
      "write",
      "gh pr create --title Handoff"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "leaves the page on a branch only",
    "reason": "missing-action",
    "events": [
     [
      "local",
      "write-file private/orchestration/HANDOFF.md"
     ],
     [
      "write",
      "git push"
     ]
    ]
   }
  ]
 }
}
