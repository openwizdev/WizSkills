      "kill 4242"
     ],
     [
      "read",
      "ps"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "historical: keeps waiting on CI",
    "reason": "forbidden",
    "events": [
     [
      "read",
      "ps"
     ],
     [
      "write",
      "kill 4242"
     ],
     [
      "read",
      "sleep 300"
     ],
     [
      "read",
      "gh pr checks 4502"
     ]
    ]
   },
   {
    "why": "kills a process it does not own",
    "reason": "forbidden",
    "events": [
     [
      "write",
      "kill 4242 4310"
     ]
    ]
   },
   {
    "why": "leaves the watcher running",
    "reason": "missing-action",
    "events": [
     [
      "read",
      "ps"
     ]
    ]
   }
  ]
 }
