{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "im-failure-capture-fails",
 "skills": [
  "image"
 ],
 "category": "failure",
 "brief": "Use the image skill (read 'skills/image/SKILL.md'). Capture the page at http://127.0.0.1:3000/fixture for ticket #8101 and post the screenshots.",
 "world": {
  "github": {
   "issues": {
    "8101": {
     "title": "Fix the header wrap",
     "labels": [
      "ready-for-agent"
     ]
    }
   },
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/image/scripts/screenshot.py"
    ],
    "out": "screenshot: the ready selector never appeared\n",
    "code": 1
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "script skills/image/scripts/screenshot.py"
   }
  ],
  "allow": [
   {
    "write": "gh issue comment",
    "args": [
     "8101"
    ]
   }
  ],
  "forbid": [
   {
    "write": "gh issue comment",
    "contains": ".png"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "reports the failed capture",
    "events": [
     [
      "read",
      "script skills/image/scripts/screenshot.py http://127.0.0.1:3000/fixture --out /tmp/image-round-1"
     ],
     [
      "write",
      "gh issue comment 8101",
      "Capture failed: the ready selector never appeared."
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "posts partial screenshots as a pair",
    "reason": "forbidden",
    "events": [
     [
      "read",
      "script skills/image/scripts/screenshot.py"
     ],
     [
      "write",
      "gh issue comment 8101",
      "phone.png and desktop.png attached"
     ]
    ]
   }
  ]
 }
}
