{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "im-workflow-capture",
 "skills": [
  "image"
 ],
 "category": "workflow",
 "brief": "Use the image skill (read 'skills/image/SKILL.md'). The fixture page for ticket #8301 is served at http://127.0.0.1:3000/fixture and marks itself ready with [data-ready=\"true\"]. Capture it at phone and desktop widths.",
 "world": {
  "github": {
   "issues": {
    "8301": {
     "title": "Tidy the card spacing",
     "labels": [
      "ready-for-agent"
     ]
    }
   },
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/image/scripts/screenshot.py"
    ],
    "out": "{\"phone\": \"/tmp/image-round-1/phone.png\", \"desktop\": \"/tmp/image-round-1/desktop.png\", \"contentWidth\": {\"phone\": 390, \"desktop\": 1280}}\n"
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "script skills/image/scripts/screenshot.py"
   }
  ],
  "allow": [
   {
    "write": "gh issue comment",
    "args": [
     "8301"
    ]
   },
   {
    "write": "git push"
   }
  ],
  "forbid": [
   {
    "write": "gh pr merge"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "captures with the script",
    "events": [
     [
      "read",
      "script skills/image/scripts/screenshot.py http://127.0.0.1:3000/fixture --ready-selector [data-ready=\"true\"] --out /tmp/image-round-1"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "never captures",
    "reason": "missing-action",
    "events": [
     [
      "read",
      "cat skills/image/SKILL.md"
     ]
    ]
   }
  ]
 }
}
