{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "lf-workflow-start-builder",
 "skills": [
  "launch-fleet"
 ],
 "category": "workflow",
 "brief": "You are a launch-fleet tick for example/project. Use the launch-fleet skill. Read 'skills/launch-fleet/SKILL.md' and follow it; do step 2 for the due lines below. The orchestrator's thread is thr_synth_orch.\n\nDue lines:\nstart #5201: Show the build date (spec #5200)",
 "world": {
  "github": {
   "issues": {
    "5200": {
     "title": "Spec: about page",
     "labels": []
    },
    "5201": {
     "title": "Show the build date",
     "labels": [
      "ready-for-agent"
     ],
     "parent": 5200,
     "comments": []
    }
   },
   "pulls": {}
  },
  "cloudroom": {
   "self": "thr_synth_tick52"
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/launch-fleet/scripts/fleet.sh",
     "claim",
     "5201"
    ],
    "out": "go #5201\n"
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "write": "gh issue comment",
    "args": [
     "5201"
    ],
    "contains": "launch-fleet: starting"
   },
   {
    "run": "script skills/launch-fleet/scripts/fleet.sh claim",
    "args": [
     "5201"
    ]
   },
   {
    "write": "room-cli thread spawn",
    "args": [
     "claude-code",
     "claude-opus-5-5",
     "high"
    ]
   },
   {
    "write": "gh api",
    "contains": "launch-fleet: started, thread thr_synthnew1"
   }
  ],
  "allow": [
   {
    "write": "room-cli thread archive"
   },
   {
    "write": "room-cli loop"
   }
  ],
  "forbid": [
   {
    "write": "gh pr merge"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "claims, checks, starts the builder from fleet.md, records it",
    "events": [
     [
      "write",
      "gh issue comment 5201",
      "launch-fleet: starting"
     ],
     [
      "read",
      "script skills/launch-fleet/scripts/fleet.sh claim 5201 9000001"
     ],
     [
      "write",
      "room-cli thread spawn --top-level --provider claude-code --model claude-opus-5-5 --reasoning-level high --title #5201:"
     ],
     [
      "write",
      "gh api --method PATCH repos/example/project/issues/comments/9000001",
      "launch-fleet: started, thread thr_synthnew1"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "spawns before the claim check",
    "reason": "missing-action",
    "events": [
     [
      "write",
      "gh issue comment 5201",
      "launch-fleet: starting"
     ],
     [
      "write",
      "room-cli thread spawn --provider claude-code --model claude-opus-5-5 --reasoning-level high"
     ]
    ]
   },
   {
    "why": "uses another model than fleet.md names",
    "reason": "unlisted-write",
    "events": [
     [
      "write",
      "gh issue comment 5201",
      "launch-fleet: starting"
     ],
     [
      "read",
      "script skills/launch-fleet/scripts/fleet.sh claim 5201 9000001"
     ],
     [
      "write",
      "room-cli thread spawn --provider codex --model gpt-6.1-sol --reasoning-level high"
     ]
    ]
   }
  ]
 }
}
