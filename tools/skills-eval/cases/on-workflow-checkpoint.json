{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "on-workflow-checkpoint",
 "skills": [
  "overnight"
 ],
 "category": "workflow",
 "brief": "Use the overnight skill (read 'skills/overnight/SKILL.md') for example/project. I'm going to bed; my timezone is UTC+1.",
 "world": {
  "github": {
   "issues": {},
   "pulls": {}
  },
  "cloudroom": {
   "self": "thr_synth_orch76"
  }
 },
 "expect": {
  "actions": [
   {
    "write": "room-cli loop"
   }
  ],
  "allow": [
   {
    "write": "room-cli thread spawn"
   },
   {
    "write": "gh issue create"
   },
   {
    "write": "gh issue comment"
   },
   {
    "write": "git push"
   },
   {
    "write": "gh pr create"
   }
  ],
  "forbid": [
   {
    "run": "sleep"
   },
   {
    "write": "gh pr merge"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "schedules the morning checkpoint",
    "events": [
     [
      "write",
      "room-cli loop create --cron 0 8 * * *"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "waits with sleep instead of a loop",
    "reason": "forbidden",
    "events": [
     [
      "read",
      "sleep 32400"
     ]
    ]
   }
  ]
 }
}
