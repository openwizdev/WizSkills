{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "rs-workflow-snapshot-then-worker",
 "skills": [
  "research"
 ],
 "category": "workflow",
 "brief": "You are the orchestrator for example/project. Use the research skill. Read 'skills/research/SKILL.md' and follow it: which browsers support the File System Access API? One worker is enough.",
 "world": {
  "github": {
   "issues": {},
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/research/scripts/check-workers.sh",
     "snapshot"
    ],
    "out": "{\"synthetic\": \"snapshot\"}\n"
   },
   {
    "argv": [
     "script",
     "skills/research/scripts/check-workers.sh",
     "check"
    ],
    "out": "clean research: nothing changed\n"
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "run": "script skills/research/scripts/check-workers.sh snapshot"
   },
   {
    "write": "room-cli thread spawn"
   }
  ],
  "allow": [
   {
    "write": "room-cli thread archive"
   },
   {
    "write": "git push"
   },
   {
    "write": "gh pr create"
   }
  ],
  "forbid": [
   {
    "write": "gh pr merge"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "snapshots, then starts the worker",
    "events": [
     [
      "read",
      "script skills/research/scripts/check-workers.sh snapshot"
     ],
     [
      "write",
      "room-cli thread spawn --title Research: File System Access"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "starts the worker before the snapshot",
    "reason": "missing-action",
    "events": [
     [
      "write",
      "room-cli thread spawn --title Research"
     ],
     [
      "read",
      "script skills/research/scripts/check-workers.sh snapshot"
     ]
    ]
   }
  ]
 }
}
