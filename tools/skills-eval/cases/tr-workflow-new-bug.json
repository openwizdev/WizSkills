{
 "schema": "openwiz.skills-eval.case.v1",
 "id": "tr-workflow-new-bug",
 "skills": [
  "triage"
 ],
 "category": "workflow",
 "brief": "You are the orchestrator for example/project. Use the triage skill. Read 'skills/triage/SKILL.md' and follow it, for issue #6001.",
 "world": {
  "github": {
   "issues": {
    "6001": {
     "title": "Button misaligned on a narrow screen",
     "labels": [],
     "body": "On a 320-pixel-wide window the Send button overflows the card.",
     "comments": []
    }
   },
   "pulls": {}
  },
  "scripts": [
   {
    "argv": [
     "script",
     "skills/triage/find-work.sh"
    ],
    "out": "#6001 new: Button misaligned on a narrow screen\n"
   }
  ]
 },
 "expect": {
  "actions": [
   {
    "write": "gh issue edit",
    "args": [
     "6001"
    ]
   }
  ],
  "allow": [
   {
    "write": "gh issue comment",
    "args": [
     "6001"
    ],
    "contains": "This was generated by AI during triage."
   },
   {
    "write": "gh label create"
   }
  ],
  "forbid": [
   {
    "write": "room-cli thread spawn"
   },
   {
    "write": "gh issue close"
   },
   {
    "write": "gh issue comment",
    "contains": "Approved on its own"
   }
  ],
  "end": "end_turn"
 },
 "controls": {
  "pass": [
   {
    "why": "labels it, briefs it, starts nothing",
    "events": [
     [
      "write",
      "gh issue comment 6001",
      "> *This was generated by AI during triage.*\n\nBrief..."
     ],
     [
      "write",
      "gh issue edit 6001 --add-label bug --add-label needs-triage"
     ]
    ]
   }
  ],
  "fail": [
   {
    "why": "starts a builder without approval",
    "reason": "forbidden",
    "events": [
     [
      "write",
      "gh issue edit 6001 --add-label ready-for-agent"
     ],
     [
      "write",
      "room-cli thread spawn --title #6001:"
     ]
    ]
   },
   {
    "why": "a comment without the AI line",
    "reason": "unlisted-write",
    "events": [
     [
      "write",
      "gh issue edit 6001 --add-label bug"
     ],
     [
      "write",
      "gh issue comment 6001",
      "Looks like CSS."
     ]
    ]
   }
  ]
 }
}
